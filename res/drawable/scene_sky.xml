<?xml version="1.0" encoding="utf-8"?>
<!-- The dog scene is drawn from shapes rather than bitmaps: there are no dog assets, and a
     layer of flat colour survives the head unit's panel better than a scaled-up photograph. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="@color/sky_bottom"
        android:startColor="@color/sky_top" />
</shape>
