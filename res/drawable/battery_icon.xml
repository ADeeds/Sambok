<?xml version="1.0" encoding="utf-8"?>
<!-- Crisp API 19 battery icon so the countdown never depends on whether the head unit's system
     fonts include a Unicode battery emoji glyph. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Battery shell -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="4dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <size
                android:width="34dp"
                android:height="20dp" />
            <corners android:radius="4dp" />
            <stroke
                android:width="2.5dp"
                android:color="@color/ink" />
        </shape>
    </item>
    <!-- Positive terminal nub -->
    <item
        android:left="34dp"
        android:top="5dp"
        android:right="0dp"
        android:bottom="5dp">
        <shape android:shape="rectangle">
            <size
                android:width="4dp"
                android:height="10dp" />
            <corners
                android:topRightRadius="2dp"
                android:bottomRightRadius="2dp" />
            <solid android:color="@color/ink" />
        </shape>
    </item>
    <!-- Charge fill -->
    <item
        android:left="5dp"
        android:top="5dp"
        android:right="11dp"
        android:bottom="5dp">
        <shape android:shape="rectangle">
            <corners android:radius="1.5dp" />
            <solid android:color="#4ADE80" />
        </shape>
    </item>
</layer-list>
