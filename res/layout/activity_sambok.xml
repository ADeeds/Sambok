<?xml version="1.0" encoding="utf-8"?>
<!-- The head unit's screen is 8:3 (1920 x 720), so the split is 3:5: the driver's panel on the
     left, the animated scene on the right. The amber strip sits above both, full width.

     The scene is a WebView showing assets/scene.svg. KitKat's WebView is Chromium, so the
     artist's own CSS animations run unmodified — there is no frame strip and no bitmap of the
     dog. The scene is INVISIBLE in every state except running, so when dog mode is off the
     right-hand section is blank. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backdrop"
    android:orientation="vertical">

    <!-- The one warning the screen has: Utility Mode dropped, or the callbacks stopped. -->
    <View
        android:id="@+id/strip"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:background="@color/amber"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:background="@drawable/panel_backdrop"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="48dp"
            android:paddingTop="32dp"
            android:paddingRight="36dp"
            android:paddingBottom="32dp">

            <TextView
                android:id="@+id/countdown_caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/countdown_caption"
                android:textAllCaps="true"
                android:textColor="@color/muted"
                android:textSize="16sp"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/countdown_unknown"
                android:textColor="@color/ink"
                android:textSize="56sp"
                android:textStyle="bold"
                android:visibility="invisible" />

            <!-- What the A/C is set to, in the car's unit; shown only while Utility Mode runs.
                 One line only, so it can never wrap and push the toggle down. -->
            <TextView
                android:id="@+id/setpoint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/ink"
                android:textSize="32sp"
                android:visibility="invisible" />

            <Button
                android:id="@+id/toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:minHeight="72dp"
                android:text="@string/toggle_off"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/status_off"
                android:textColor="@color/muted"
                android:textSize="18sp" />

            <!-- Shown only while the dropped warning is up: acknowledges it and returns the
                 screen to off without writing anything to the car. -->
            <Button
                android:id="@+id/dismiss"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:minHeight="56dp"
                android:text="@string/dismiss"
                android:textSize="18sp"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/scene"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="5"
            android:visibility="invisible">

            <WebView
                android:id="@+id/scene_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent" />

            <!-- Wipes the seam where the panel's ramp meets the artwork's own background. -->
            <View
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:layout_gravity="left"
                android:background="@drawable/seam_feather" />
        </FrameLayout>
    </LinearLayout>
</LinearLayout>
